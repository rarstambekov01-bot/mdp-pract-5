states = ["A","B","C","D","E","S","F","H","I"]
actions = ["UP","DOWN","LEFT","RIGHT"]
pos = {"A":(0,0),"B":(0,1),"C":(0,2),"G":(0,3),
       "D":(1,0),"E":(1,2),"X":(1,3),
       "S":(2,0),"F":(2,1),"H":(2,2),"I":(2,3)}
name = {v: k for k, v in pos.items()}
move = {"UP":(-1,0),"DOWN":(1,0),"LEFT":(0,-1),"RIGHT":(0,1)}
sides = {"UP":("LEFT","RIGHT"), "DOWN":("RIGHT","LEFT"),
         "LEFT":("DOWN","UP"),  "RIGHT":("UP","DOWN")}
gamma, theta = 0.9, 0.001
 
def go(s, d):          # қабырғаға тірелсе - орнында қалады
    r, c = pos[s]; dr, dc = move[d]
    return name.get((r+dr, c+dc), s)
 
def reward(s2):
    return 10 if s2 == "G" else -10 if s2 == "X" else -0.1
 
def transitions(s, a):
    left, right = sides[a]
    res = []
    for p, d in [(0.8, a), (0.1, left), (0.1, right)]:
        s2 = go(s, d)
        res.append((p, s2, reward(s2)))
    return res
